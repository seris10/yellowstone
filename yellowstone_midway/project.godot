; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Yellowstone · Midway"
config/description="A georeferenced, fixed landscape study of Midway Geyser Basin."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Mobile")

[audio]

default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[physics]

3d/default_gravity=9.81

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.43, 0.61, 0.7, 1)

[yellowstone]

live_url="http://127.0.0.1:8765"
shadows/preset="walking"
shadows/range_override_m=0.0
shadows/split_1=0.04
shadows/split_2=0.14
shadows/split_3=0.4
shadows/blend_splits=true
shadows/fade_start=0.82
shadows/bias=0.03
shadows/normal_bias=3.0

[input]

menu={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":80), Object(InputEventJoypadButton,"button_index":11)]
}

