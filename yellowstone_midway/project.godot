[physics]

3d/default_gravity=9.81

[rendering]

renderer/rendering_method="mobile"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
; Mobile 4.5.1 uses FXAA to keep sampled depth finite.
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.43, 0.61, 0.7, 1)

[yellowstone]

live_url="http://127.0.0.1:8765"
shadows/preset="walking"
shadows/range_override_m=0.0
shadows/split_1=0.04
shadows/split_2=0.14
shadows/split_3=0.4
shadows/blend_splits=true
shadows/fade_start=0.82
shadows/bias=0.03
shadows/normal_bias=3.0
park_streaming/enabled=false
park_streaming/catalog="res://data/park/catalog.json"
park_streaming/max_inflight=2
park_streaming/resident_limit_mib=128.0
park_streaming/commit_budget_ms=1.5
park_streaming/live_url="http://127.0.0.1:8766"
